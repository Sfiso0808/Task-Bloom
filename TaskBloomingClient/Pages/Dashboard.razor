@page "/dashboard"
@inject HttpClient Http

<h3>📊 Dashboard Summary</h3>

@if (summary == null)
{
    <p>Loading...</p>
}
else
{
    <ul>
        <li>Total Tasks: <b>@summary.Total</b></li>
        <li>✅ Completed: <span class="text-success">@summary.Completed</span></li>
        <li>⏳ Pending: <span class="text-warning">@summary.Pending</span></li>
    </ul>
}

@code {
    private DashboardSummary? summary;

    protected override async Task OnInitializedAsync()
    {
        var tasks = await Http.GetFromJsonAsync<List<TaskModel>>("http://localhost:5194/api/Task");
        if (tasks != null)
        {
            summary = new DashboardSummary
                {
                    Total = tasks.Count,
                    Completed = tasks.Count(t => t.IsCompleted),
                    Pending = tasks.Count(t => !t.IsCompleted)
                };
        }
    }

    class DashboardSummary
    {
        public int Total { get; set; }
        public int Completed { get; set; }
        public int Pending { get; set; }
    }

    public class TaskModel
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime DueDate { get; set; }
        public int Priority { get; set; }
        public bool IsCompleted { get; set; }
    }
}
